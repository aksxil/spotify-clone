<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Liked Songs — AKSXIL Music</title>

  <link
    href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/stylesheets/liked.css">
</head>

<body>

  <div id="main">

    <!-- ================= MOBILE HEADER ================= -->

    <header class="mobile-header">

      <div class="mobile-brand">

        <div class="mobile-logo">
          <i class="ri-music-2-fill"></i>
        </div>

        <span>AKSXIL</span>

      </div>

      <button
        id="menubtn"
        class="mobile-menu-btn"
      >
        <i class="ri-menu-4-line"></i>
      </button>

    </header>


    <!-- ================= SIDEBAR ================= -->

    <aside class="left" id="sidebar">

      <div class="sidebar-content">

        <!-- LOGO -->

        <div class="logo">

          <div class="logo-icon">
            <i class="ri-music-2-fill"></i>
          </div>

          <div>
            <h2>AKSXIL</h2>
            <span>Music</span>
          </div>

        </div>


        <!-- NAVIGATION -->

        <nav class="navigation">

          <a
            href="/"
            class="nav-item"
          >
            <i class="ri-home-5-fill"></i>
            <span>Home</span>
          </a>


          <a
            href="/search"
            class="nav-item"
          >
            <i class="ri-search-line"></i>
            <span>Search</span>
          </a>


          <a
            href="/"
            class="nav-item"
          >
            <i class="ri-add-line"></i>
            <span>Create Playlist</span>
          </a>


          <a
            href="/liked"
            class="nav-item active"
          >
            <i class="ri-heart-3-fill liked-icon"></i>
            <span>Liked Songs</span>
          </a>

        </nav>


        <!-- LIBRARY -->

        <div class="library">

          <div class="library-title">
            <span>Your Library</span>

            <i class="ri-music-list-line"></i>
          </div>

          <a href="/liked" class="library-item active-library">

            <div class="library-thumb">
              <i class="ri-heart-3-fill"></i>
            </div>

            <div class="library-text">

              <strong>Liked Songs</strong>

              <small>
                Your favorite music
              </small>

            </div>

          </a>

        </div>

      </div>


      <!-- SIDEBAR BOTTOM -->

      <div class="sidebar-bottom">

        <div class="sidebar-note">

          <i class="ri-headphone-fill"></i>

          <span>
            Keep listening
          </span>

        </div>


        <a
          href="/Logout"
          class="logout"
        >

          <i class="ri-logout-box-r-line"></i>

          <span>Logout</span>

        </a>

      </div>

    </aside>


    <!-- ================= MAIN ================= -->

    <main class="right">


      <!-- TOP BAR -->

      <div class="topbar">

        <div class="history-buttons">

          <button>
            <i class="ri-arrow-left-line"></i>
          </button>

          <button>
            <i class="ri-arrow-right-line"></i>
          </button>

        </div>


        <div class="topbar-right">

          <a
            href="/search"
            class="search-mini"
          >

            <i class="ri-search-line"></i>

            <span>Search</span>

          </a>


          <div class="profile">

            <div class="profile-avatar">
              <i class="ri-user-3-fill"></i>
            </div>

          </div>

        </div>

      </div>


      <!-- ================= PAGE CONTENT ================= -->

      <section class="content">


        <!-- HERO -->

        <div class="liked-hero">

          <div class="liked-cover">

            <i class="ri-heart-3-fill"></i>

          </div>


          <div class="liked-info">

            <span class="eyebrow">
              PLAYLIST
            </span>

            <h1>
              Liked Songs
            </h1>

            <p>
              Songs you've saved to your favorites.
            </p>


            <div class="liked-meta">

              <span>
                <i class="ri-heart-3-fill"></i>
                Your collection
              </span>

              <span class="dot">
                •
              </span>

              <span>
                <%= likedSongs.length %> songs
              </span>

            </div>

          </div>

        </div>


        <!-- ================= CONTROLS ================= -->

        <div class="liked-controls">

          <button
            class="big-play"
            id="playAll"
          >

            <i class="ri-play-fill"></i>

          </button>


          <button class="control-button">

            <i class="ri-shuffle-line"></i>

          </button>


          <button class="control-button">

            <i class="ri-more-fill"></i>

          </button>

        </div>


        <!-- ================= SONG LIST ================= -->

        <div class="song-list">

          <div class="song-list-header">

            <span class="number">
              #
            </span>

            <span class="track-heading">
              TITLE
            </span>

            <span class="artist-heading">
              ARTIST
            </span>

            <span class="heart-heading">
              <i class="ri-heart-3-fill"></i>
            </span>

          </div>


          <% if (likedSongs.length === 0) { %>

            <div class="empty-state">

              <div class="empty-icon">
                <i class="ri-heart-3-line"></i>
              </div>

              <h2>
                No liked songs yet
              </h2>

              <p>
                Songs you like will appear here.
              </p>

              <a href="/">
                Discover music
                <i class="ri-arrow-right-line"></i>
              </a>

            </div>

          <% } else { %>


            <% likedSongs.forEach((song, index) => { %>

              <div
                class="song-row"
                data-filename="<%= song.filename %>"
                data-title="<%= song.title %>"
                data-artist="<%= song.artist %>"
                data-poster="<%= song.poster %>"
                onclick="songCardClicked(
                  '<%= song.filename %>',
                  '<%= song.title %>',
                  '<%= song.artist %>',
                  '<%= song.poster %>'
                )"
              >


                <!-- NUMBER -->

                <div class="song-number">

                  <span class="number-normal">
                    <%= index + 1 %>
                  </span>

                  <i class="ri-play-fill number-play"></i>

                </div>


                <!-- TITLE -->

                <div class="song-title">

                  <div class="song-cover">

                    <img
                      src="/poster/<%= song.poster %>"
                      alt="<%= song.title %>"
                      loading="lazy"
                    >

                    <div class="cover-play">
                      <i class="ri-play-fill"></i>
                    </div>

                  </div>


                  <div class="song-name">

                    <h3>
                      <%= song.title %>
                    </h3>

                    <p>
                      <%= song.artist %>
                    </p>

                  </div>

                </div>


                <!-- ARTIST -->

                <div class="song-artist">

                  <span>
                    <%= song.artist %>
                  </span>

                </div>


                <!-- LIKE -->

                <form
                  action="/like/<%= song._id %>"
                  method="POST"
                  class="remove-like-form"
                  onclick="event.stopPropagation();"
                >

                  <button
                    type="submit"
                    class="remove-like"
                    title="Remove from liked songs"
                  >

                    <i class="ri-heart-3-fill"></i>

                  </button>

                </form>


              </div>

            <% }); %>

          <% } %>

        </div>


        <div class="bottom-space"></div>

      </section>


      <!-- ================= CUSTOM PLAYER ================= -->

      <div class="player">


        <!-- PLAYER SONG -->

        <div class="player-song">

          <div class="player-art">

            <img
              id="playerPoster"
              src="https://play-lh.googleusercontent.com/cShys-AmJ93dB0SV8kE6Fl5eSaf4-qMMZdwEDKI5VEmKAXfzOqbiaeAsqqrEBCTdIEs=w240-h480-rw"
              alt="Currently playing"
            >

          </div>


          <div class="player-info">

            <h4 id="playerTitle">
              Nothing playing
            </h4>

            <p id="playerArtist">
              Choose a song
            </p>

          </div>


          <button class="player-like">

            <i class="ri-heart-3-line"></i>

          </button>

        </div>


        <!-- PLAYER CENTER -->

        <div class="player-center">

          <div class="player-controls">

            <button>
              <i class="ri-shuffle-line"></i>
            </button>

            <button>
              <i class="ri-skip-back-fill"></i>
            </button>

            <button
              id="mainPlay"
              class="main-play"
            >
              <i class="ri-play-fill"></i>
            </button>

            <button>
              <i class="ri-skip-forward-fill"></i>
            </button>

            <button>
              <i class="ri-repeat-2-line"></i>
            </button>

          </div>


          <div class="progress-wrapper">

            <span id="currentTime">
              0:00
            </span>

            <input
              id="progress"
              type="range"
              min="0"
              max="100"
              value="0"
            >

            <span id="duration">
              0:00
            </span>

          </div>

        </div>


        <!-- VOLUME -->

        <div class="player-volume">

          <i class="ri-volume-up-line"></i>

          <input
            id="volume"
            type="range"
            min="0"
            max="1"
            step="0.01"
            value="1"
          >

        </div>

      </div>


      <!-- ACTUAL AUDIO -->

      <audio id="audio"></audio>


    </main>

  </div>


  <!-- ================= JAVASCRIPT ================= -->

  <script>

    const audio = document.querySelector("#audio");

    const sidebar = document.querySelector("#sidebar");

    const menuButton = document.querySelector("#menubtn");

    const mainPlay = document.querySelector("#mainPlay");

    const progress = document.querySelector("#progress");

    const volume = document.querySelector("#volume");

    const currentTime = document.querySelector("#currentTime");

    const duration = document.querySelector("#duration");

    const playerTitle = document.querySelector("#playerTitle");

    const playerArtist = document.querySelector("#playerArtist");

    const playerPoster = document.querySelector("#playerPoster");


    /* ==========================================
       MOBILE MENU
    ========================================== */

    menuButton.addEventListener("click", function () {

      sidebar.classList.toggle("mobile-open");

      const icon = menuButton.querySelector("i");

      if (sidebar.classList.contains("mobile-open")) {

        icon.className = "ri-close-line";

      } else {

        icon.className = "ri-menu-4-line";

      }

    });


    /* ==========================================
       CLOSE MENU AFTER NAVIGATION
    ========================================== */

    document.querySelectorAll(".left a").forEach(function(link) {

      link.addEventListener("click", function() {

        sidebar.classList.remove("mobile-open");

        menuButton.querySelector("i").className =
          "ri-menu-4-line";

      });

    });


    /* ==========================================
       PLAY SONG
    ========================================== */

    function songCardClicked(
      filename,
      title,
      artist,
      poster
    ) {

      audio.src = "/stream/" + filename;

      playerTitle.textContent = title;

      playerArtist.textContent = artist;

      playerPoster.src = "/poster/" + poster;

      audio.play();

    }


    /* ==========================================
       MAIN PLAY / PAUSE
    ========================================== */

    mainPlay.addEventListener("click", function () {

      if (!audio.src) return;


      if (audio.paused) {

        audio.play();

      } else {

        audio.pause();

      }

    });


    /* ==========================================
       PLAY / PAUSE ICON
    ========================================== */

    audio.addEventListener("play", function () {

      mainPlay.innerHTML =
        '<i class="ri-pause-fill"></i>';

    });


    audio.addEventListener("pause", function () {

      mainPlay.innerHTML =
        '<i class="ri-play-fill"></i>';

    });


    /* ==========================================
       AUDIO TIME UPDATE
    ========================================== */

    audio.addEventListener("timeupdate", function () {

      if (!audio.duration) return;

      const percentage =
        (audio.currentTime / audio.duration) * 100;

      progress.value = percentage;

      currentTime.textContent =
        formatTime(audio.currentTime);

    });


    /* ==========================================
       AUDIO METADATA
    ========================================== */

    audio.addEventListener(
      "loadedmetadata",
      function () {

        duration.textContent =
          formatTime(audio.duration);

      }
    );


    /* ==========================================
       PROGRESS BAR
    ========================================== */

    progress.addEventListener("input", function () {

      if (!audio.duration) return;

      audio.currentTime =
        (progress.value / 100) *
        audio.duration;

    });


    /* ==========================================
       VOLUME
    ========================================== */

    volume.addEventListener("input", function () {

      audio.volume = volume.value;

    });


    /* ==========================================
       FORMAT TIME
    ========================================== */

    function formatTime(seconds) {

      if (isNaN(seconds)) {
        return "0:00";
      }

      const minutes =
        Math.floor(seconds / 60);

      const secondsLeft =
        Math.floor(seconds % 60);

      return (
        minutes +
        ":" +
        String(secondsLeft).padStart(2, "0")
      );

    }


    /* ==========================================
       PLAY ALL
    ========================================== */

    const playAll =
      document.querySelector("#playAll");

    if (playAll) {

      playAll.addEventListener("click", function () {

        const firstSong =
          document.querySelector(".song-row");

        if (!firstSong) return;

        songCardClicked(
          firstSong.dataset.filename,
          firstSong.dataset.title,
          firstSong.dataset.artist,
          firstSong.dataset.poster
        );

      });

    }


    /* ==========================================
       ROW HOVER PLAY ICON
    ========================================== */

    document
      .querySelectorAll(".song-row")
      .forEach(function(row) {

        row.addEventListener(
          "mouseenter",
          function() {

            row.classList.add("hovering");

          }
        );

        row.addEventListener(
          "mouseleave",
          function() {

            row.classList.remove("hovering");

          }
        );

      });

  </script>

</body>

</html>