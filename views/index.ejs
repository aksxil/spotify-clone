<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>AKSXIL Music</title>

  <link
    href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

  <div id="main">

    <!-- ================= MOBILE HEADER ================= -->
    <header class="mobile-header">
      <div class="brand">
        <div class="brand-icon">
          <i class="ri-music-2-fill"></i>
        </div>
        <span>AKSXIL</span>
      </div>

      <button id="menubtn" class="mobile-menu-btn">
        <i class="ri-menu-4-line"></i>
      </button>
    </header>


    <!-- ================= SIDEBAR ================= -->
    <aside class="left" id="sidebar">

      <div class="sidebar-top">

        <!-- Logo -->
        <div class="logo">
          <div class="logo-icon">
            <i class="ri-music-2-fill"></i>
          </div>

          <div>
            <h2>AKSXIL</h2>
            <span>Music</span>
          </div>
        </div>


        <!-- Navigation -->
        <nav class="navigation">

          <a href="/" class="nav-item active">
            <i class="ri-home-5-fill"></i>
            <span>Home</span>
          </a>

          <a href="/search" class="nav-item">
            <i class="ri-search-line"></i>
            <span>Search</span>
          </a>

          <button id="play" class="nav-item nav-button">
            <i class="ri-add-line"></i>
            <span>Create Playlist</span>
          </button>

          <a href="/liked" class="nav-item">
            <i class="ri-heart-3-fill liked-icon"></i>
            <span>Liked Songs</span>
          </a>

        </nav>


        <!-- Create Playlist -->
        <form
          id="playlist"
          action="/createplaylist"
          method="POST"
        >

          <div class="playlist-input">

            <input
              id="cplaylist"
              type="text"
              name="name"
              placeholder="Playlist name..."
              required
            >

            <button id="cbtn" type="submit">
              <i class="ri-check-line"></i>
            </button>

          </div>

        </form>


        <!-- Library -->
        <div class="library">

          <div class="library-header">
            <h3>Your Library</h3>

            <i
              class="ri-add-line"
              id="libraryAdd"
            ></i>
          </div>


          <div class="playlists">

            <% playlists.forEach(function(playlist) { %>

              <a
                href="/playlist/<%= playlist._id %>"
                class="playlist-item"
              >

                <div class="playlist-icon">
                  <i class="ri-play-list-2-fill"></i>
                </div>

                <span>
                  <%= playlist.name %>
                </span>

              </a>

            <% }) %>

          </div>

        </div>

      </div>


      <!-- ================= SIDEBAR CURRENT SONG ================= -->

      <div class="sidebar-bottom">

        <div class="playing-label">
          <span>NOW PLAYING</span>

          <i class="ri-equalizer-2-line"></i>
        </div>


        <div id="song-details">

          <div class="current-artwork">

            <img
              src="https://play-lh.googleusercontent.com/cShys-AmJ93dB0SV8kE6Fl5eSaf4-qMMZdwEDKI5VEmKAXfzOqbiaeAsqqrEBCTdIEs=w240-h480-rw"
              alt="Currently playing"
            >

            <div class="artwork-overlay">
              <i class="ri-music-2-fill"></i>
            </div>

          </div>


          <div class="inbox">

            <h2>Nothing playing</h2>

            <p>Select a song</p>

          </div>

        </div>


        <a href="/Logout" class="logout">

          <i class="ri-logout-box-r-line"></i>

          <span>Logout</span>

        </a>

      </div>

    </aside>


    <!-- ================= MAIN CONTENT ================= -->

    <main class="right">

      <!-- Top bar -->
      <div class="topbar">

        <div class="history-buttons">

          <button>
            <i class="ri-arrow-left-line"></i>
          </button>

          <button>
            <i class="ri-arrow-right-line"></i>
          </button>

        </div>


        <div class="topbar-right">

          <a href="/search" class="search-mini">
            <i class="ri-search-line"></i>
            <span>Search</span>
          </a>

          <div class="profile">

            <div class="profile-avatar">
              <i class="ri-user-3-fill"></i>
            </div>

          </div>

        </div>

      </div>


      <!-- ================= CONTENT ================= -->

      <section class="content">

        <!-- Hero -->
        <div class="hero">

          <div class="hero-content">

            <span class="hero-small">
              YOUR MUSIC
            </span>

            <h1>
              Good music.<br>
              <span>Good mood.</span>
            </h1>

            <p>
              Listen to your favorite tracks and discover
              something new today.
            </p>

            <div class="hero-actions">

              <a href="#songs" class="hero-play">
                <i class="ri-play-fill"></i>
                Play music
              </a>

              <a href="/liked" class="hero-secondary">
                <i class="ri-heart-3-line"></i>
                Liked songs
              </a>

            </div>

          </div>


          <div class="hero-decoration">

            <div class="hero-disc">

              <div class="disc-center">
                <i class="ri-music-2-fill"></i>
              </div>

            </div>

          </div>

        </div>


        <!-- ================= SONG SECTION ================= -->

        <div class="section-header" id="songs">

          <div>
            <span class="section-eyebrow">
              YOUR COLLECTION
            </span>

            <h2>All Songs</h2>
          </div>

          <a href="/search" class="show-all">
            Show all
            <i class="ri-arrow-right-line"></i>
          </a>

        </div>


        <div class="music">

          <% currentUser.playlist[0].songs.forEach(function(song){ %>

            <div
              class="card"
              onclick="songCardClicked(
                '<%= song.filename %>',
                '<%= song.title %>',
                '<%= song.artist %>',
                '<%= song.poster %>'
              );"
            >

              <!-- Album artwork -->

              <div class="img">

                <img
                  src="/poster/<%= song.poster %>"
                  alt="<%= song.title %>"
                  loading="lazy"
                >

                <div class="card-gradient"></div>

                <button
                  class="play-card"
                  onclick="event.stopPropagation(); songCardClicked(
                    '<%= song.filename %>',
                    '<%= song.title %>',
                    '<%= song.artist %>',
                    '<%= song.poster %>'
                  );"
                >

                  <i class="ri-play-fill"></i>

                </button>

              </div>


              <!-- Song information -->

              <div class="textos">

                <h3 title="<%= song.title %>">
                  <%= song.title %>
                </h3>

                <p title="<%= song.artist %>">
                  <%= song.artist %>
                </p>

              </div>


              <!-- Like -->

              <form
                action="/like/<%= song._id %>"
                method="POST"
                class="like-form"
                onclick="event.stopPropagation();"
              >

                <button
                  type="submit"
                  class="like-button"
                >

                  <% if (currentUser.likes.includes(song._id.toString())) { %>

                    <i class="ri-heart-3-fill liked"></i>

                  <% } else { %>

                    <i class="ri-heart-3-line"></i>

                  <% } %>

                </button>

              </form>

            </div>

          <% }) %>

        </div>


        <!-- Bottom spacing -->

        <div class="bottom-space"></div>

      </section>


      <!-- ================= CUSTOM PLAYER ================= -->

      <div class="player">

        <!-- Left -->

        <div class="player-song">

          <div class="player-art">

            <img
              id="playerPoster"
              src="https://play-lh.googleusercontent.com/cShys-AmJ93dB0SV8kE6Fl5eSaf4-qMMZdwEDKI5VEmKAXfzOqbiaeAsqqrEBCTdIEs=w240-h480-rw"
              alt="Song"
            >

          </div>


          <div class="player-info">

            <h4 id="playerTitle">
              Nothing playing
            </h4>

            <p id="playerArtist">
              Choose a song
            </p>

          </div>


          <button class="player-like">
            <i class="ri-heart-3-line"></i>
          </button>

        </div>


        <!-- Center -->

        <div class="player-center">

          <div class="player-controls">

            <button>
              <i class="ri-shuffle-line"></i>
            </button>

            <button>
              <i class="ri-skip-back-fill"></i>
            </button>

            <button
              id="mainPlay"
              class="main-play"
            >
              <i class="ri-play-fill"></i>
            </button>

            <button>
              <i class="ri-skip-forward-fill"></i>
            </button>

            <button>
              <i class="ri-repeat-2-line"></i>
            </button>

          </div>


          <div class="progress-wrapper">

            <span id="currentTime">
              0:00
            </span>

            <input
              id="progress"
              type="range"
              min="0"
              max="100"
              value="0"
            >

            <span id="duration">
              0:00
            </span>

          </div>

        </div>


        <!-- Right -->

        <div class="player-volume">

          <i class="ri-volume-up-line"></i>

          <input
            id="volume"
            type="range"
            min="0"
            max="1"
            step="0.01"
            value="1"
          >

        </div>

      </div>


      <!-- Actual audio element -->

      <audio id="audio"></audio>

    </main>

  </div>


  <!-- ================= JAVASCRIPT ================= -->

  <script>

    const audio = document.querySelector("#audio");

    const sidebar = document.querySelector("#sidebar");

    const menuButton = document.querySelector("#menubtn");

    const playlistButton = document.querySelector("#play");

    const playlistForm = document.querySelector("#playlist");

    const playlistInput = document.querySelector("#cplaylist");

    const createButton = document.querySelector("#cbtn");

    const mainPlay = document.querySelector("#mainPlay");

    const progress = document.querySelector("#progress");

    const volume = document.querySelector("#volume");

    const currentTime = document.querySelector("#currentTime");

    const duration = document.querySelector("#duration");

    const playerTitle = document.querySelector("#playerTitle");

    const playerArtist = document.querySelector("#playerArtist");

    const playerPoster = document.querySelector("#playerPoster");


    /* ==========================================
       MOBILE MENU
    ========================================== */

    menuButton.addEventListener("click", function () {

      sidebar.classList.toggle("mobile-open");

      const icon = menuButton.querySelector("i");

      if (sidebar.classList.contains("mobile-open")) {

        icon.className = "ri-close-line";

      } else {

        icon.className = "ri-menu-4-line";

      }

    });


    /* ==========================================
       CLOSE MOBILE MENU WHEN LINK CLICKED
    ========================================== */

    document.querySelectorAll(".left a").forEach(function(link) {

      link.addEventListener("click", function() {

        sidebar.classList.remove("mobile-open");

        const icon = menuButton.querySelector("i");

        icon.className = "ri-menu-4-line";

      });

    });


    /* ==========================================
       CREATE PLAYLIST
    ========================================== */

    playlistButton.addEventListener("click", function () {

      playlistForm.classList.toggle("show");

      if (playlistForm.classList.contains("show")) {

        setTimeout(function() {

          playlistInput.focus();

        }, 100);

      }

    });


    /* ==========================================
       LIBRARY ADD BUTTON
    ========================================== */

    const libraryAdd = document.querySelector("#libraryAdd");

    if (libraryAdd) {

      libraryAdd.addEventListener("click", function() {

        playlistForm.classList.add("show");

        playlistInput.focus();

      });

    }


    /* ==========================================
       ENTER CREATE PLAYLIST
    ========================================== */

    playlistInput.addEventListener("keyup", function(event) {

      if (event.key === "Enter") {

        createButton.click();

      }

    });


    /* ==========================================
       SONG PLAY FUNCTION
    ========================================== */

    function songCardClicked(
      filename,
      title,
      artist,
      poster
    ) {

      audio.src = "/stream/" + filename;

      audio.play();

      playerTitle.textContent = title;

      playerArtist.textContent = artist;

      playerPoster.src = "/poster/" + poster;


      /* Sidebar current song */

      const songDetails = document.querySelector("#song-details");

      songDetails.innerHTML = `

        <div class="current-artwork">

          <img
            src="/poster/${poster}"
            alt="${title}"
          >

          <div class="artwork-overlay">
            <i class="ri-equalizer-2-fill"></i>
          </div>

        </div>

        <div class="inbox">

          <h2>${title}</h2>

          <p>${artist}</p>

        </div>

      `;


      /* Change play icon */

      mainPlay.innerHTML =
        '<i class="ri-pause-fill"></i>';

    }


    /* ==========================================
       PLAY / PAUSE
    ========================================== */

    mainPlay.addEventListener("click", function() {

      if (!audio.src) return;

      if (audio.paused) {

        audio.play();

        mainPlay.innerHTML =
          '<i class="ri-pause-fill"></i>';

      } else {

        audio.pause();

        mainPlay.innerHTML =
          '<i class="ri-play-fill"></i>';

      }

    });


    /* ==========================================
       AUDIO PLAY
    ========================================== */

    audio.addEventListener("play", function() {

      mainPlay.innerHTML =
        '<i class="ri-pause-fill"></i>';

    });


    /* ==========================================
       AUDIO PAUSE
    ========================================== */

    audio.addEventListener("pause", function() {

      mainPlay.innerHTML =
        '<i class="ri-play-fill"></i>';

    });


    /* ==========================================
       AUDIO TIME
    ========================================== */

    audio.addEventListener("timeupdate", function() {

      if (!audio.duration) return;

      const percent =
        (audio.currentTime / audio.duration) * 100;

      progress.value = percent;

      currentTime.textContent =
        formatTime(audio.currentTime);

    });


    /* ==========================================
       AUDIO LOADED
    ========================================== */

    audio.addEventListener("loadedmetadata", function() {

      duration.textContent =
        formatTime(audio.duration);

    });


    /* ==========================================
       PROGRESS CONTROL
    ========================================== */

    progress.addEventListener("input", function() {

      if (!audio.duration) return;

      audio.currentTime =
        (progress.value / 100) * audio.duration;

    });


    /* ==========================================
       VOLUME
    ========================================== */

    volume.addEventListener("input", function() {

      audio.volume = volume.value;

    });


    /* ==========================================
       FORMAT TIME
    ========================================== */

    function formatTime(seconds) {

      if (isNaN(seconds)) return "0:00";

      const minutes =
        Math.floor(seconds / 60);

      const remainingSeconds =
        Math.floor(seconds % 60);

      return (
        minutes +
        ":" +
        String(remainingSeconds).padStart(2, "0")
      );

    }


    /* ==========================================
       AUTO CLOSE PLAYLIST
    ========================================== */

    document.addEventListener("click", function(event) {

      if (
        playlistForm.classList.contains("show") &&
        !playlistForm.contains(event.target) &&
        !playlistButton.contains(event.target) &&
        !libraryAdd?.contains(event.target)
      ) {

        playlistForm.classList.remove("show");

      }

    });

  </script>

</body>
</html>