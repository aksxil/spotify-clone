<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Spotify Clone — Login</title>

    <link
        href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body class="auth-page">

    <!-- Toggle -->
    <input type="radio" name="optionScreen" id="SignIn" hidden checked>
    <input type="radio" name="optionScreen" id="SignUp" hidden>

    <main class="auth-container">

        <!-- Background Glow -->
        <div class="auth-glow glow-one"></div>
        <div class="auth-glow glow-two"></div>

        <section class="auth-card">

            <!-- Logo -->
            <div class="auth-logo">
                <div class="logo-icon">
                    <i class="ri-spotify-fill"></i>
                </div>

                <div>
                    <h1>Spotify</h1>
                    <p>Music for everyone.</p>
                </div>
            </div>

            <!-- Tabs -->
            <nav class="auth-tabs">
                <label for="SignIn">
                    Sign In
                </label>

                <label for="SignUp">
                    Sign Up
                </label>
            </nav>


            <!-- ================= SIGN IN ================= -->

            <form
                action="/login"
                id="SignInFormData"
                class="auth-form"
                method="post"
            >

                <div class="form-heading">
                    <h2>Welcome back</h2>
                    <p>Sign in to continue listening.</p>
                </div>


                <!-- Username -->

                <div class="input-group">

                    <label for="username">
                        Username
                    </label>

                    <div class="input-wrapper">

                        <i class="ri-user-3-line"></i>

                        <input
                            type="text"
                            id="username"
                            name="username"
                            placeholder="Enter your username"
                            autocomplete="username"
                            required
                        >

                    </div>

                </div>


                <!-- Password -->

                <div class="input-group">

                    <label for="password">
                        Password
                    </label>

                    <div class="input-wrapper">

                        <i class="ri-lock-2-line"></i>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                            required
                        >

                    </div>

                </div>


                <!-- Options -->

                <div class="form-options">

                    <label class="check-option">

                        <input
                            type="checkbox"
                            id="staySingedIn"
                            checked
                        >

                        <span class="custom-check"></span>

                        <span>Stay signed in</span>

                    </label>

                    <a href="#">
                        Forgot password?
                    </a>

                </div>


                <!-- Submit -->

                <button
                    class="auth-submit"
                    type="submit"
                >

                    <span>Sign In</span>

                    <i class="ri-arrow-right-line"></i>

                </button>

            </form>


            <!-- ================= SIGN UP ================= -->

            <form
                action="/register"
                id="SignUpFormData"
                class="auth-form"
                method="post"
            >

                <div class="form-heading">
                    <h2>Create your account</h2>
                    <p>Join and start listening to your favorite music.</p>
                </div>


                <!-- Username -->

                <div class="input-group">

                    <label for="signup-name">
                        Username
                    </label>

                    <div class="input-wrapper">

                        <i class="ri-user-3-line"></i>

                        <input
                            type="text"
                            id="signup-name"
                            name="username"
                            placeholder="Choose a username"
                            autocomplete="username"
                            required
                        >

                    </div>

                </div>


                <!-- Email -->

                <div class="input-group">

                    <label for="email">
                        Email
                    </label>

                    <div class="input-wrapper">

                        <i class="ri-mail-line"></i>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Enter your email"
                            autocomplete="email"
                            required
                        >

                    </div>

                </div>


                <!-- Password -->

                <div class="input-group">

                    <label for="signup-password">
                        Password
                    </label>

                    <div class="input-wrapper">

                        <i class="ri-lock-2-line"></i>

                        <input
                            type="password"
                            id="signup-password"
                            name="password"
                            placeholder="Create a password"
                            autocomplete="new-password"
                            required
                        >

                    </div>

                </div>


                <!-- Options -->

                <div class="form-options">

                    <label class="check-option">

                        <input
                            type="checkbox"
                            id="staySingedUp"
                        >

                        <span class="custom-check"></span>

                        <span>Stay signed in</span>

                    </label>

                </div>


                <!-- Submit -->

                <button
                    class="auth-submit"
                    type="submit"
                >

                    <span>Create Account</span>

                    <i class="ri-arrow-right-line"></i>

                </button>

            </form>


            <!-- Footer -->

            <div class="auth-footer">

                <i class="ri-music-2-fill"></i>

                <span>Listen. Discover. Repeat.</span>

            </div>

        </section>

    </main>

</body>
</html>